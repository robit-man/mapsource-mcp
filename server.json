{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.robit-man/mapsource",
  "title": "Mapsource",
  "description": "Official local stdio adapter for the hosted Mapsource geospatial MCP server.",
  "repository": {
    "url": "https://github.com/robit-man/mapsource-mcp",
    "source": "github"
  },
  "version": "0.1.1",
  "websiteUrl": "https://mapsource.io/docs/agents",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "mapsource-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MAPSOURCE_API_KEY",
          "description": "Mapsource subscription key",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
